{
  "name": "backup-file-cleaner",
  "version": "1.0.0",
  "description": "Automated Google Drive smart cleanup service running via PM2",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "gLogin": "node index.js --login",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop backup-file-cleaner",
    "restart:pm2": "pm2 restart backup-file-cleaner",
    "status:pm2": "pm2 status",
    "logs:pm2": "pm2 logs backup-file-cleaner",
    "cleanup:once": "node index.js --once",
    "cleanup:start": "node index.js"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.4",
    "node-cron": "^3.0.3"
  }
}
